# Gonets settings. Copy to .env and fill in. Empty value = default.

# --- Telegram ---
TELEGRAM_BOT_TOKEN=123456:replace-me
# Numeric Telegram user ids allowed to use the bot, comma-separated (required).
TELEGRAM_ALLOWED_USER_IDS=000000000
# Groups (forum supergroups) where the bot works, comma-separated chat ids.
# Empty = private chats of allowed users only.
TELEGRAM_ALLOWED_CHAT_IDS=

# --- Language and time ---
# Language of bot messages: en (default) or ru.
CLAUDE_TG_BOT_LANG=en
# Time zone for scheduled jobs (Europe/Berlin). Empty = system time zone.
CLAUDE_TG_BOT_TZ=

# --- Claude Code ---
# Absolute path to the claude CLI: systemd does not see your shell PATH.
CLAUDE_BIN=
# The agent's working directory. Empty = your home directory.
CLAUDE_CWD=
# Settings file with the approval hook. Empty = claude-hook-settings.json in
# the repository (install.sh renders it from the example).
CLAUDE_HOOK_SETTINGS=
# Persona appended to the system prompt. Empty = telegram-persona.md.
CLAUDE_TG_BOT_PERSONA_FILE=
# Project map for forum topics (see projects.example.json). Empty = projects.json.
CLAUDE_TG_BOT_PROJECTS_FILE=
# Sessions, audit log, attachments. Use an absolute path. Empty = ./state.
CLAUDE_TG_BOT_STATE_DIR=
# Default --effort: low|medium|high|xhigh|max. /effort changes it per chat.
CLAUDE_TG_BOT_EFFORT=high
# Model alias or id (--model). Empty = CLI default. /model changes it per chat.
CLAUDE_MODEL=
# Choices for the /model buttons, comma-separated. Empty = fable, opus, sonnet, haiku.
CLAUDE_MODEL_CHOICES=
# Auto-compact window (--autocompact): auto or 100k-1M. Empty = CLI default.
# CLAUDE_AUTOCOMPACT_CHATS limits it to chat keys (chat_id or chat_id:thread_id).
CLAUDE_AUTOCOMPACT=
CLAUDE_AUTOCOMPACT_CHATS=
# Prompt cache warm-up: after CLAUDE_TG_WARM_IDLE_MIN minutes of silence
# (5-55, default 55) the bot sends a hidden turn to a fork of the chat's
# session that reads the conversation from cache and keeps it alive for
# another hour. Only inside CLAUDE_TG_WARM_HOURS local time (HH-HH, end
# excluded). CLAUDE_TG_WARM_CHATS: chat keys, comma separated; empty = off.
CLAUDE_TG_WARM_CHATS=
CLAUDE_TG_WARM_HOURS=09-22
CLAUDE_TG_WARM_IDLE_MIN=55
# A topic idle longer than this many hours starts a fresh session. 0 = never.
SESSION_IDLE_TTL_HOURS=30
# Claude subscription limit reserve: from 97% of the five-hour or 99% of the
# weekly window only the owner's messages in these topics run; background runs
# and other topics wait for the reset. Chat keys, comma separated
# ("<chat_id>" or "<chat_id>:<thread_id>"); empty = no reserve.
CLAUDE_TG_LIMIT_RESERVE_CHATS=
# Hard limit for one claude run, seconds. 0 = no limit (not recommended).
MAX_CLAUDE_RUNTIME_SEC=3600
# Alert with sound when a run has been silent this long, seconds. 0 = off.
RUN_SILENCE_ALERT_SEC=600
# One "still working" note per run after this many seconds. 0 = off.
RUN_PROGRESS_NOTE_SEC=900
# Cost footer after each answer, and the context size that suggests /reset.
SHOW_COST_FOOTER=true
CONTEXT_WARN_TOKENS=200000
# Scheduled skills that must pin a memory scope: allowed scopes, comma-separated.
CLAUDE_TG_BOT_MEMORY_SCOPES=
LOG_LEVEL=INFO

# --- Approval server (inside the bot, receives the PreToolUse hook) ---
# Keep it on loopback. A non-loopback address requires APPROVE_SHARED_SECRET.
APPROVE_HTTP_HOST=127.0.0.1
APPROVE_HTTP_PORT=8788
# How long a card waits for your tap, seconds. Capped by the hook timeout in
# claude-hook-settings.json minus 60 s.
APPROVE_TIMEOUT_SEC=900
# Shared secret for the X-Approve-Token header of /approve, /event and /restart.
APPROVE_SHARED_SECRET=

# --- What passes without a card (empty by default: everything asks) ---
# Directories (absolute, colon-separated) where Write/Edit pass without a card.
APPROVE_WHITELIST_PATHS=
# Chat keys where every tool passes without a card, including background runs
# in that chat. A conscious trade-off; leave empty unless you understand it.
APPROVE_AUTO_CHAT_KEYS=
# Shell commands that pass without a card. Each segment of a command (split on
# | ; && || and newlines, quotes respected) must fully match. Never add exec
# wrappers (env, xargs, sudo, timeout, ssh, bash, sh): they run arbitrary
# commands. Write and exec flags of find, rg, git grep, sort and tree are
# denied separately in code. A conservative example:
# APPROVE_BASH_AUTO_ALLOW_REGEX=^(?:pwd|whoami|date|hostname|uname|uptime|true|false|ls|git status|git diff|git branch|git remote -v|rg --files)$
APPROVE_BASH_AUTO_ALLOW_REGEX=
# Read-only MCP tools that pass without a card (full match on the tool name
# without mcp__<server>__). The default lets get/list/search/read/query pass.
# APPROVE_MCP_AUTO_ALLOW_REGEX=
# Shared data the agent changes only through its own command under a lock
# (for example an assistant's journal and tables): Write and Edit there are
# denied with a hint. Absolute paths, comma separated; a directory covers
# everything inside.
# APPROVE_GUARDED_DATA_PATHS=/home/user/src/assistant/journal,/home/user/src/assistant/data
APPROVE_GUARDED_DATA_PATHS=
# How to change such files, shown in the denial.
APPROVE_GUARDED_DATA_HINT=

# --- Voice (optional): OpenAI speech-to-text and text-to-speech ---
# Without a key voice is off and the bot works with text only.
OPENAI_API_KEY=
OPENAI_STT_MODEL=gpt-transcribe
# Topic of your speech in one sentence, and literal terms (names, hosts).
OPENAI_STT_PROMPT=
OPENAI_STT_KEYWORDS=
# Language hints, comma-separated (en,de). Empty = auto-detect.
OPENAI_STT_LANGUAGES=
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=nova
OPENAI_TTS_INSTRUCTIONS=
VOICE_REPLY_MAX_CHARS=4000
VOICE_MAX_DURATION_SEC=180

# --- Telegram limits and files ---
TELEGRAM_TEXT_LIMIT=4000
TELEGRAM_CAPTION_LIMIT=1024
# Answers longer than this are sent as a file.
LARGE_REPLY_AS_FILE_THRESHOLD=12000
ATTACHMENT_TTL_DAYS=30
PHOTO_MAX_SIZE_BYTES=10485760
DOCUMENT_MAX_SIZE_BYTES=524288000
# Attachments over 20 MB (the Bot API getFile limit) are downloaded over
# MTProto, logged in as the bot itself. App keys from my.telegram.org
# (API development tools). Empty = large files are refused with a message.
# The session is kept in state/telethon-bot.session.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Free disk space that must remain after a large download, bytes.
DOWNLOAD_MIN_FREE_BYTES=2147483648
# Time limit for one large download, seconds.
BIG_DOWNLOAD_TIMEOUT_SEC=1800
# /usage runs ccusage through npx. Empty = npx from PATH.
NPX_BIN=

# --- Codex fallback (optional) ---
# Absolute path to the native codex binary. Empty = Codex integration off.
CODEX_BIN=
# Answer through Codex when claude fails with 401, 429 or 5xx.
CODEX_FALLBACK=true
CODEX_TIMEOUT_SEC=600
# Sandbox for messages with CODEX_PREFIX, and for the automatic fallback.
CODEX_SANDBOX=workspace-write
CODEX_FALLBACK_SANDBOX=read-only
# Network inside the Codex sandbox. Codex has no approval cards: with true it
# can make any network request without asking.
CODEX_NETWORK_ACCESS=false
CODEX_PREFIX=gpt:

# --- Outbound mail with attachments (mailsend, optional) ---
# Gmail login and app password; empty = taken from MAILSEND_ENV (default .env).
GMAIL_USER=
GMAIL_APP_PASSWORD=
MAILSEND_ENV=
# Directories attachments may come from, colon-separated.
MAILSEND_ATTACH_DIRS=
MAILSEND_MAX_BYTES=

# --- Skill: digest of unread chats (Telethon user session, optional) ---
CHAT_DIGEST_SOURCE_CHAT_IDS=
# Output topic: both values or nothing.
CHAT_DIGEST_TG_CHAT_ID=
CHAT_DIGEST_TG_THREAD_ID=
# .env with TELEGRAM_API_ID, TELEGRAM_API_HASH and TELEGRAM_SESSION_STRING.
CHAT_DIGEST_TELEGRAM_ENV=
CHAT_DIGEST_TIMEOUT_SEC=480
CHAT_DIGEST_MAX_PER_TOPIC=600
CHAT_DIGEST_MAX_CHARS=200000

# --- Skill: morning news digest (optional) ---
# Output topic: both values or nothing. Task topics (/task) live in this group.
NEWS_TG_CHAT_ID=
NEWS_TG_THREAD_ID=
NEWS_DIGEST_MODEL=
NEWS_DIGEST_TIMEOUT_SEC=600
# Optional GitHub token (public read only) for repository search.
NEWS_GITHUB_TOKEN=
NEWS_BACKLOG_MODEL=
